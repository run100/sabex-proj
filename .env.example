APP_NAME=SABExistCount
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://www.sabex.lab:7510

SAB_WWW_HOST=www.sabex.lab
SAB_ADMIN_HOST=x.sabex.lab
GEOFLOW_ROOT=/Users/coolshell/projects/ai2024/geo-ant-design-pro

ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://www.sabex.lab/auth/roblox/callback

# Production: both false. Email login/register routes 404 when false.
# /auth/email/verify stays registered so already-sent links still work.
ALLOW_EMAIL_LOGIN=false
ALLOW_EMAIL_BIND=false

FAIR_THRESHOLD_PERCENT=5
TRADE_EXPIRE_HOURS=72
MAX_ITEMS_PER_SIDE=9
MAX_ACTIVE_LISTINGS_PER_USER=10
POST_TRADE_LIMIT_PER_HOUR=10
JOIN_LIMIT_PER_HOUR=30
REPORT_LIMIT_PER_DAY=20
TRADE_MODERATOR_ROBLOX_SUBS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sabexistcount
DB_USERNAME=root
DB_PASSWORD=

CONSOLE_PATH=j8xq-4n2m-w9kp
ADMIN_ALLOW_IPS=127.0.0.1,::1

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
